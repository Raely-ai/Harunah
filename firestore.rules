rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isNotBanned() {
      return !isAuthenticated() || 
             !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == false;
    }

    function isOwnerNotBanned(userId) {
      return isOwner(userId) && 
             (resource == null || resource.data.get('isBanned', false) == false);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          (request.auth.token.email == "hpferdicakir@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
        );
    }

    function isSocialOperator() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'social_operator';
    }

    function hasElevatedAccess() {
      return isAdmin() || isSocialOperator();
    }

    function isValidUser(data) {
      return data.get('role', 'user') in ['user', 'admin', 'social_operator'] &&
             data.get('isBanned', false) is bool &&
             (!('social' in data) || data.social is map);
    }

    // User Profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.get('role', 'user') == 'user' && 
                      request.resource.data.get('isBanned', false) == false;
      allow update: if hasElevatedAccess() || (
        isOwner(userId) && 
        (resource.data.get('isBanned', false) == false) &&
        isValidUser(request.resource.data) &&
        // 1. Prevent self-promotion or unbanning
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'subscription']) &&
        // 2. Protect credits (only allow decreasing)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits']) || 
         request.resource.data.get('credits', 0) <= resource.data.get('credits', 0)) &&
        // 3. Protect adCredits (only allow increasing)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['adCredits']) || 
         request.resource.data.get('adCredits', 0) >= resource.data.get('adCredits', 0))
      );
      allow delete: if isAdmin();
    }

    // Social Swipes
    match /swipes/{swipeId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
      allow create: if isAuthenticated() && isNotBanned() && (request.resource.data.fromUserId == request.auth.uid || hasElevatedAccess());
      allow update: if isAuthenticated() && isNotBanned() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid || hasElevatedAccess());
      allow delete: if isAuthenticated() && (
        resource == null || // Allow deleting non-existent docs (cleanup)
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
    }

    // Interaction Requests
    match /interactionRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
      allow create: if isAuthenticated() && isNotBanned() && 
                      (request.resource.data.fromUserId == request.auth.uid || hasElevatedAccess()) &&
                      request.resource.data.get('type', '') in ['like', 'message', 'super_like', 'message_request'] &&
                      request.resource.data.get('message', '').size() <= 500;
      allow update: if isAuthenticated() && isNotBanned() && (
        (request.auth.uid in [resource.data.fromUserId, resource.data.toUserId] || hasElevatedAccess()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'updatedAt']) &&
        request.resource.data.status in ['accepted', 'rejected', 'pending']
      );
      allow delete: if isAuthenticated() && (
        resource == null || // Allow deleting non-existent docs (cleanup)
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        request.auth.uid in resource.data.participants || 
        hasElevatedAccess()
      );
      allow create: if isAuthenticated() && isNotBanned() && (
        (request.auth.uid in request.resource.data.participants || hasElevatedAccess()) &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.get('lastMessage', '').size() <= 500
      );
      allow update: if isAuthenticated() && isNotBanned() && (
        (request.auth.uid in resource.data.participants && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']) &&
         request.resource.data.get('lastMessage', '').size() <= 500) || 
        hasElevatedAccess()
      );
      allow delete: if hasElevatedAccess();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        hasElevatedAccess() ||
        (exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
         request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid || 
        request.resource.data.senderId == "system" ||
        hasElevatedAccess()
      );
      allow update: if isAuthenticated() && (
        hasElevatedAccess() || 
        request.auth.uid == resource.data.senderId ||
        (
          // Allow recipient to update status (delivered/seen)
          exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if hasElevatedAccess() || (
        request.auth.uid == resource.data.senderId
      );
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Social Reports
    match /socialReports/{reportId} {
      allow read: if isAdmin() || hasElevatedAccess();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || hasElevatedAccess();
    }

    // Readings
    match /readings/{readingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isNotBanned() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid);
    }

    // Horoscopes
    match /horoscopes/{horoscopeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if true; // AI needs to read prompts
      allow write: if isAdmin();
    }

    // Global Config
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
