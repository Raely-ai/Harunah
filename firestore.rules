rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isNotBanned() {
      return !isAuthenticated() || 
             !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == false;
    }

    function isOwnerNotBanned(userId) {
      return isOwner(userId) && 
             (resource == null || resource.data.get('isBanned', false) == false);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          (request.auth.token.email == "hpferdicakir@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
        );
    }

    function isSocialOperator() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'social_operator';
    }

    function hasElevatedAccess() {
      return isAdmin() || isSocialOperator();
    }

    function isValidReport(data) {
      return data.reporterId == request.auth.uid &&
             data.reportedUserId is string &&
             data.source in ['messages', 'profile', 'match', 'discovery'] &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.status == 'pending' &&
             data.createdAt is timestamp;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && 
        (resource.data.get('isBanned', false) == false) &&
        isValidUser(request.resource.data) &&
        // 1. Prevent self-promotion or unbanning
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned']) &&
        // 2. PRODUCTION HARDENING: Prevent direct modification of wallet/subscription fields
        // These fields MUST only be updated via Cloud Functions (Admin SDK) in production.
        // We allow the update IF the field is being set to its current value (no change)
        // OR if the field was missing and is being set to 0/initial value (initialization)
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'mainCoins', 'energy', 'superLikes', 'refreshCount', 'compatibilityCount',
            'subscription', 'socialSubscription', 'dailyAdWatchCount', 'lastAdReset',
            'boostExpiresAt', 'isManagedProfile', 'operatorId'
          ]) ||
          // Allow initialization if the document was incomplete
          (
            resource.data.get('mainCoins', -1) == -1 && 
            request.resource.data.mainCoins == 0
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Social Swipes
    match /swipes/{swipeId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
      allow create: if isAuthenticated() && isNotBanned() && (request.resource.data.fromUserId == request.auth.uid || hasElevatedAccess());
      allow update: if isAuthenticated() && isNotBanned() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid || hasElevatedAccess());
      allow delete: if isAuthenticated() && (
        resource == null || // Allow deleting non-existent docs (cleanup)
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
    }

    // Interaction Requests
    match /interactionRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
      allow create: if isAuthenticated() && isNotBanned() && 
                      (request.resource.data.fromUserId == request.auth.uid || hasElevatedAccess()) &&
                      request.resource.data.get('type', '') in ['like', 'message', 'super_like', 'message_request'] &&
                      request.resource.data.get('message', '').size() <= 500;
      allow update: if isAuthenticated() && isNotBanned() && (
        (request.auth.uid in [resource.data.fromUserId, resource.data.toUserId] || hasElevatedAccess()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'updatedAt']) &&
        request.resource.data.status in ['accepted', 'rejected', 'pending']
      );
      allow delete: if isAuthenticated() && (
        resource == null || // Allow deleting non-existent docs (cleanup)
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        hasElevatedAccess()
      );
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        request.auth.uid in resource.data.participants || 
        hasElevatedAccess()
      );
      allow create: if isAuthenticated() && isNotBanned() && (
        (request.auth.uid in request.resource.data.participants || hasElevatedAccess()) &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.get('lastMessage', '').size() <= 500
      );
      allow update: if isAuthenticated() && isNotBanned() && (
        (request.auth.uid in resource.data.participants && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']) &&
         request.resource.data.get('lastMessage', '').size() <= 500) || 
        hasElevatedAccess()
      );
      allow delete: if hasElevatedAccess();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        hasElevatedAccess() ||
        (exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
         request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid || 
        request.resource.data.senderId == "system" ||
        hasElevatedAccess()
      );
      allow update: if isAuthenticated() && (
        hasElevatedAccess() || 
        request.auth.uid == resource.data.senderId ||
        (
          // Allow recipient to update status (delivered/seen)
          exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if hasElevatedAccess() || (
        request.auth.uid == resource.data.senderId
      );
    }

    // Reports
    match /reports/{reportId} {
      allow read: if hasElevatedAccess();
      allow create: if isAuthenticated() && isValidReport(request.resource.data);
      allow update: if hasElevatedAccess() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Social Transactions
    match /socialTransactions/{txId} {
      allow read: if isAdmin() || hasElevatedAccess() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || hasElevatedAccess();
    }

    // Withdrawal Requests
    match /withdrawalRequests/{requestId} {
      allow read: if isAdmin() || hasElevatedAccess() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || hasElevatedAccess();
    }

    // Social Gift Transactions
    match /socialGiftTransactions/{txId} {
      allow read: if isAdmin() || hasElevatedAccess() || (isAuthenticated() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || hasElevatedAccess();
    }

    // Hosting Packages
    match /hostingPackages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasElevatedAccess();
    }

    // Moderation Logs
    match /moderationLogs/{logId} {
      allow read: if isAdmin() || hasElevatedAccess();
      allow create: if isAdmin() || hasElevatedAccess();
      allow update, delete: if isAdmin() || hasElevatedAccess();
    }

    // Readings
    match /readings/{readingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isNotBanned() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid);
    }

    // Wallet Transactions
    match /walletTransactions/{txId} {
      // Use request.auth.uid directly for query compatibility if possible, 
      // but resource.data is needed for single doc reads and general security.
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      // PRODUCTION HARDENING: Only system/admin should create transactions.
      // In a real app, this would be done via Admin SDK in Cloud Functions.
      allow create: if isAdmin(); 
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Social Rooms
    match /socialRooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if hasElevatedAccess();
    }

    // Test Connection
    match /test/{testId} {
      allow read: if true;
    }

    // Horoscopes
    match /horoscopes/{horoscopeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if true; // AI needs to read prompts
      allow write: if isAdmin();
    }

    // Global Config
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Settings
    match /adminSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
