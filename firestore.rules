rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "hpferdicakir@gmail.com" || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isParticipant(data) {
      return isAuthenticated() && (request.auth.uid in data.participants);
    }

    // --- Collections ---

    // Users: Profiles are public to logged-in users, but writes are restricted
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'mainCoins', 'energy', 'subscription', 'isBanned']);
      allow delete: if isAdmin();
    }

    // Chats: Only participants can read. Writes only via Functions.
    match /chats/{chatId} {
      allow read: if isParticipant(resource.data) || isAdmin();
      allow write: if false; 
    }

    // Messages: Only participants can read. Writes only via Functions.
    match /messages/{messageId} {
      allow read: if isParticipant(resource.data) || isAdmin();
      allow write: if false;
    }

    // Interaction Requests: Sender and Receiver can read. Writes only via Functions.
    match /interactionRequests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId || isAdmin());
      allow write: if false;
    }

    // Notifications: Only owner can read/update/delete. Create only via Functions.
    match /notifications/{notificationId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
    }

    // Swipes: Read by owner. Writes only via Functions.
    match /swipes/{swipeId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.fromUserId || isAdmin());
      allow write: if false;
    }

    // Reports: Admin only read. Create only via Functions.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Wallet & Economy: Admin only or Backend only
    match /walletTransactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Readings (Fortunes): Owner can read/create.
    match /readings/{readingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Compatibility
    match /compatibilityHistory/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // Default deny for everything else
    match /{path=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
