{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user balance, subscription and social profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "mainCoins": { "type": "integer", "default": 0 },
        "energy": { "type": "integer", "default": 0 },
        "superLikes": { "type": "integer", "default": 0 },
        "refreshCount": { "type": "integer", "default": 0 },
        "compatibilityCount": { "type": "integer", "default": 0 },
        "dailyAdWatchCount": { "type": "integer", "default": 0 },
        "lastAdReset": { "type": "string", "format": "date-time" },
        "boostExpiresAt": { "type": "string", "format": "date-time" },
        "isBanned": { "type": "boolean", "default": false },
        "role": { "type": "string", "enum": ["user", "admin", "social_operator"], "default": "user" },
        "social": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "profileCompleted": { "type": "boolean" },
            "nickname": { "type": "string" },
            "gender": { "type": "string", "enum": ["erkek", "kadın"] },
            "lookingFor": { "type": "string" },
            "bio": { "type": "string" },
            "photos": { "type": "array", "items": { "type": "string" } },
            "interests": { "type": "array", "items": { "type": "string" } },
            "visible": { "type": "boolean" },
            "banned": { "type": "boolean" },
            "lastDiscoverRefreshAt": { "type": "string", "format": "date-time" },
            "lastFreeRefreshAt": { "type": "string", "format": "date-time" },
            "blockedUserIds": { "type": "array", "items": { "type": "string" } },
            "mutedUserIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "subscription": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["active", "inactive", "expired", "none"] },
            "type": { "type": "string", "enum": ["none", "daily", "weekly", "monthly"] },
            "expiresAt": { "type": "string", "format": "date-time" },
            "dailyLimitUsed": { "type": "integer", "default": 0 }
          }
        }
      },
      "required": ["uid", "email", "mainCoins", "energy", "role"]
    },
    "AdminWalletConfig": {
      "title": "Admin Wallet Config",
      "description": "Configuration for wallet prices and ad rewards.",
      "type": "object",
      "properties": {
        "adRewardEnergy": { "type": "integer" },
        "maxDailyAds": { "type": "integer" },
        "adRewardExpiryDays": { "type": "integer" },
        "dailyLoginRewardEnergy": { "type": "integer" },
        "dailyLoginExpiryDays": { "type": "integer" },
        "fortuneSubscriptions": {
          "type": "object",
          "properties": {
            "daily": { "type": "object" },
            "weekly": { "type": "object" },
            "monthly": { "type": "object" }
          }
        },
        "socialRightsPrices": {
          "type": "object",
          "properties": {
            "superLike": { "type": "integer" },
            "refresh": { "type": "integer" },
            "compatibility": { "type": "integer" }
          }
        },
        "socialBundles": {
          "type": "array",
          "items": { "type": "object" }
        },
        "coinPackages": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "WalletTransaction": {
      "title": "Wallet Transaction",
      "description": "A single credit or energy transaction record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["earn", "spend", "purchase", "expire"] },
        "source": { "type": "string", "enum": ["ad", "daily_login", "admin_promo", "purchase", "fortune_reading", "social_action", "subscription_bonus"] },
        "amount": { "type": "integer" },
        "balanceType": { "type": "string", "enum": ["main", "energy"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "remainingAmount": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "spent", "expired"] },
        "description": { "type": "string" }
      },
      "required": ["id", "userId", "type", "source", "amount", "balanceType", "createdAt", "remainingAmount", "status"]
    },
    "AppConfig": {
      "title": "App Configuration",
      "description": "Global settings for prices, limits, and icons.",
      "type": "object",
      "properties": {
        "prices": {
          "type": "object",
          "properties": {
            "coffee": { "type": "integer" },
            "tarot": { "type": "integer" },
            "palm": { "type": "integer" },
            "dream": { "type": "integer" },
            "extraQuestion": { "type": "integer" }
          }
        },
        "icons": {
          "type": "object",
          "properties": {
            "coffee": { "type": "string" },
            "tarot": { "type": "string" },
            "palm": { "type": "string" },
            "dream": { "type": "string" },
            "mainBalance": { "type": "string" },
            "adCredits": { "type": "string" }
          }
        },
        "dailyMessagePrompt": { "type": "string" },
        "adRewardAmount": { "type": "integer" },
        "maxDailyAds": { "type": "integer" },
        "subscriptionLimits": {
          "type": "object",
          "properties": {
            "daily": { "type": "integer" },
            "weekly": { "type": "integer" },
            "monthly": { "type": "integer" }
          }
        },
        "packagePrices": {
          "type": "object",
          "description": "Prices for credit and subscription packages"
        }
      }
    },
    "Notification": {
      "title": "Global Notification",
      "description": "Notifications sent to all users.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      }
    },
    "Reading": {
      "title": "Fortune Reading",
      "description": "A single fortune reading request and result.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "interpreting", "completed"] },
        "date": { "type": "string", "format": "date-time" },
        "isPriority": { "type": "boolean" }
      },
      "required": ["id", "type", "userId", "status", "date"]
    },
    "Prompts": {
      "title": "Prompts",
      "description": "AI prompts for different fortune types",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "Fortune type (coffee, tarot, etc.)" },
        "content": { "type": "string", "description": "The prompt template with placeholders" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "content"]
    },
    "Chat": {
      "title": "Chat Session",
      "description": "A conversation between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantSnapshots": { "type": "object", "description": "Denormalized user data for fast list rendering" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageStatus": { "type": "string", "enum": ["sent", "delivered", "seen"] },
        "unreadCount": { "type": "object", "description": "Unread message count per user" },
        "typing": { "type": "object", "description": "Typing status per user" },
        "status": { "type": "string", "enum": ["active", "archived"] }
      }
    },
    "Message": {
      "title": "Chat Message",
      "description": "A single message within a chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "delivered", "seen"] },
        "seen": { "type": "boolean", "default": false },
        "type": { "type": "string", "enum": ["text", "image", "video", "system"] }
      }
    },
    "InteractionRequest": {
      "title": "Interaction Request",
      "description": "A request for a message or super like.",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "type": { "type": "string", "enum": ["message_request", "super_like"] },
        "messagePreview": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Swipe": {
      "title": "User Swipe",
      "description": "A swipe action (like, pass, super_like).",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "pass", "super_like"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Report": {
      "title": "Centralized Report",
      "description": "A report against a user or content for inappropriate behavior.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "reportedUserId": { "type": "string" },
        "source": { "type": "string", "description": "Module or screen where the report originated (e.g., 'messages', 'profile', 'match')" },
        "reason": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved", "dismissed"], "default": "pending" },
        "metadata": { "type": "object", "description": "Additional context about the report" }
      },
      "required": ["reporterId", "reportedUserId", "source", "reason", "createdAt", "status"]
    },
    "PromoCode": {
      "title": "Promo Code",
      "description": "Campaign codes for rewards and subscriptions.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "isActive": { "type": "boolean" },
        "startsAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maxTotalUses": { "type": "integer" },
        "maxUsesPerUser": { "type": "integer" },
        "currentUses": { "type": "integer" },
        "onlyNewUsers": { "type": "boolean" },
        "description": { "type": "string" },
        "source": { "type": "string" },
        "sourceName": { "type": "string" },
        "rewards": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["code", "isActive", "rewards", "createdAt"]
    },
    "PromoCodeRedemption": {
      "title": "Promo Code Redemption",
      "description": "Log of users who redeemed a promo code.",
      "type": "object",
      "properties": {
        "promoCodeId": { "type": "string" },
        "code": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "rewards": { "type": "object" }
      },
      "required": ["promoCodeId", "code", "userId", "redeemedAt"]
    },
    "CompatibilityHistory": {
      "title": "Compatibility History",
      "description": "Stores results of compatibility analyses between users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "source": { "type": "string", "enum": ["discover", "manual"] },
        "targetUserId": { "type": "string" },
        "targetName": { "type": "string" },
        "targetPhoto": { "type": "string" },
        "relationshipType": { "type": "string" },
        "loveScore": { "type": "integer" },
        "friendshipScore": { "type": "integer" },
        "energyScore": { "type": "integer" },
        "summaryShort": { "type": "string" },
        "summaryLong": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "cacheKey": { "type": "string" }
      },
      "required": ["id", "userId", "targetUserId", "relationshipType", "createdAt", "cacheKey"]
    },
    "CompatibilityRequest": {
      "title": "Compatibility Request",
      "description": "Stores pending compatibility analysis requests for delayed processing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "person1": { "type": "object" },
        "person2": { "type": "object" },
        "relationshipType": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "error"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "readyAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "status", "createdAt", "readyAt"]
    },
    "CompatibilityPeek": {
      "title": "Compatibility Peek",
      "description": "Stores notifications for when a user is curious about another's compatibility.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "fromUserName": { "type": "string" },
        "fromUserPhoto": { "type": "string" },
        "fromUserAge": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["fromUserId", "toUserId", "createdAt"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": "Prompts",
      "description": "Collection of AI prompt templates"
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles and balances"
    },
    "/config/global": {
      "schema": "AppConfig",
      "description": "Global app settings"
    },
    "/adminSettings/wallet": {
      "schema": "AdminWalletConfig",
      "description": "Wallet prices and ad settings"
    },
    "/readings/{readingId}": {
      "schema": "Reading",
      "description": "Fortune readings"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Global notifications"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Active chat sessions"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual chat messages"
    },
    "/interactionRequests/{requestId}": {
      "schema": "InteractionRequest",
      "description": "Pending message and super like requests"
    },
    "/swipes/{swipeId}": {
      "schema": "Swipe",
      "description": "User swipe history"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Centralized user and content reports"
    },
    "/walletTransactions/{transactionId}": {
      "schema": "WalletTransaction",
      "description": "Credit and energy transaction history"
    },
    "/promoCodes/{promoCodeId}": {
      "schema": "PromoCode",
      "description": "Campaign and promotion codes"
    },
    "/promoCodeRedemptions/{redemptionId}": {
      "schema": "PromoCodeRedemption",
      "description": "Redemption logs for promo codes"
    },
    "/compatibilityHistory/{id}": {
      "schema": "CompatibilityHistory",
      "description": "History of compatibility analyses"
    },
    "/compatibilityRequests/{id}": {
      "schema": "CompatibilityRequest",
      "description": "Pending compatibility analysis requests"
    },
    "/compatibilityPeeks/{id}": {
      "schema": "CompatibilityPeek",
      "description": "Records of users who analyzed someone else's compatibility"
    }
  }
}
