{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user balance, subscription and ad credit information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "zodiac": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "credits": { "type": "integer", "description": "Main balance" },
        "adCredits": { "type": "integer", "description": "Credits earned from ads" },
        "dailyAdCount": { "type": "integer", "description": "Ads watched today" },
        "lastAdDate": { "type": "string", "format": "date" },
        "dailyAdReadingsUsed": {
          "type": "object",
          "properties": {
            "coffee": { "type": "integer", "default": 0 },
            "tarot": { "type": "integer", "default": 0 },
            "lastResetDate": { "type": "string", "format": "date-time" }
          }
        },
        "isBanned": { "type": "boolean", "default": false },
        "role": { "type": "string", "enum": ["user", "admin"], "default": "user" },
        "subscription": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["active", "expired", "none"] },
            "type": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
            "expiresAt": { "type": "string", "format": "date-time" },
            "dailyReadingsUsed": { "type": "integer" }
          }
        }
      },
      "required": ["uid", "email", "credits", "adCredits", "dailyAdCount"]
    },
    "AppConfig": {
      "title": "App Configuration",
      "description": "Global settings for prices, limits, and icons.",
      "type": "object",
      "properties": {
        "prices": {
          "type": "object",
          "properties": {
            "coffee": { "type": "integer" },
            "tarot": { "type": "integer" },
            "palm": { "type": "integer" },
            "dream": { "type": "integer" },
            "extraQuestion": { "type": "integer" }
          }
        },
        "icons": {
          "type": "object",
          "properties": {
            "coffee": { "type": "string" },
            "tarot": { "type": "string" },
            "palm": { "type": "string" },
            "dream": { "type": "string" },
            "mainBalance": { "type": "string" },
            "adCredits": { "type": "string" }
          }
        },
        "dailyMessagePrompt": { "type": "string" },
        "adRewardAmount": { "type": "integer" },
        "maxDailyAds": { "type": "integer" },
        "subscriptionLimits": {
          "type": "object",
          "properties": {
            "daily": { "type": "integer" },
            "weekly": { "type": "integer" },
            "monthly": { "type": "integer" }
          }
        },
        "packagePrices": {
          "type": "object",
          "description": "Prices for credit and subscription packages"
        }
      }
    },
    "Horoscope": {
      "title": "Daily Horoscope",
      "description": "Daily interpretations for each zodiac sign.",
      "type": "object",
      "properties": {
        "sign": { "type": "string" },
        "interpretation": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["sign", "interpretation", "date"]
    },
    "Notification": {
      "title": "Global Notification",
      "description": "Notifications sent to all users.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      }
    },
    "Reading": {
      "title": "Fortune Reading",
      "description": "A single fortune reading request and result.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "interpreting", "completed"] },
        "date": { "type": "string", "format": "date-time" },
        "isPriority": { "type": "boolean" }
      },
      "required": ["id", "type", "userId", "status", "date"]
    },
    "Prompts": {
      "title": "Prompts",
      "description": "AI prompts for different fortune types",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "Fortune type (coffee, tarot, etc.)" },
        "content": { "type": "string", "description": "The prompt template with placeholders" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "content"]
    },
    "Chat": {
      "title": "Chat Session",
      "description": "A conversation between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "archived"] }
      }
    },
    "Message": {
      "title": "Chat Message",
      "description": "A single message within a chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "seen": { "type": "boolean", "default": false },
        "type": { "type": "string", "enum": ["text", "system"] }
      }
    },
    "InteractionRequest": {
      "title": "Interaction Request",
      "description": "A request for a message or super like.",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "type": { "type": "string", "enum": ["message_request", "super_like"] },
        "messagePreview": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Swipe": {
      "title": "User Swipe",
      "description": "A swipe action (like, pass, super_like).",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "pass", "super_like"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Report": {
      "title": "User Report",
      "description": "A report against a user for inappropriate behavior.",
      "type": "object",
      "properties": {
        "reporterUserId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved"] }
      }
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": "Prompts",
      "description": "Collection of AI prompt templates"
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles and balances"
    },
    "/config/global": {
      "schema": "AppConfig",
      "description": "Global app settings"
    },
    "/readings/{readingId}": {
      "schema": "Reading",
      "description": "Fortune readings"
    },
    "/horoscopes/{horoscopeId}": {
      "schema": "Horoscope",
      "description": "Daily horoscopes"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Global notifications"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Active chat sessions"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual chat messages"
    },
    "/interactionRequests/{requestId}": {
      "schema": "InteractionRequest",
      "description": "Pending message and super like requests"
    },
    "/swipes/{swipeId}": {
      "schema": "Swipe",
      "description": "User swipe history"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User reports"
    }
  }
}
